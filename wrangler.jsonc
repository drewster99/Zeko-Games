{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zeko-games-website",
  "compatibility_date": "2026-10-04",
  "observability": { "enabled": true },
  // Assets-only Worker: no script, everything is served straight from the asset
  // bundle. _headers and .assetsignore at the root are honored, and unknown
  // paths get 404.html with a 404 status.
  "assets": { "directory": ".", "not_found_handling": "404-page" },
  "workers_dev": false,
  "preview_urls": false,
  // custom_domain makes wrangler create the DNS record and certificate on deploy.
  "routes": [ { "pattern": "zeko.games", "custom_domain": true } ]
}
